# Optional runtime override. Normal builds generate this automatically under
# rbnx-build; set it only when RBNX_PIPER_SDK_BUILD=0 or when testing another
# checkout. The directory must contain piper_sdk/.
# PIPER_SDK_PARENT=/absolute/path/to/piper-sdk-parent

# Initial SDK-backend motion state. Runtime unlock still uses the operator-only
# motion_lock gRPC interface after a runtime lock or emergency stop.
ROBONIX_ALLOW_MOTION=0
